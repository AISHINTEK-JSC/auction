APP_NAME="Chốt Giá"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8802

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Email through Amazon SES: set MAIL_MAILER=ses. Uses the AWS_* keys above
# (empty = the server's IAM role). The sender address must be verified in SES,
# in this same region. Accounts made with the new AWS sign-up (settings.aws.com)
# only reach their project's region (Vietnam: ap-southeast-2) and us-east-1/us-west-2.
# AWS_SES_REGION=ap-southeast-2

# Text messages (the codes that confirm a member's phone number).
# log = written to storage/logs, not sent (local development); sns = Amazon SNS.
SMS_DRIVER=log
# Default to the AWS_* keys above; set these for a separate IAM user with sns:Publish.
# AWS_SNS_KEY=
# AWS_SNS_SECRET=
AWS_SNS_REGION=ap-southeast-2
# Brand name registered with Vietnamese carriers (max 11 letters/digits). Empty = carrier default.
AWS_SNS_SENDER_ID=

VITE_APP_NAME="${APP_NAME}"

# Auction engine (/auction/sourcecode). The token is a tenant-wide secret: server side only.
AUCTION_ENGINE_URL=http://localhost:8801/api/v1
AUCTION_ENGINE_TOKEN=
AUCTION_ENGINE_PUSH_KEY=
AUCTION_ENGINE_CALCULATE_TYPE=2

# Fixed-price listings expire after this many days.
FIXED_LISTING_DAYS=30

# Captcha on registration and on posting a listing (Cloudflare Turnstile).
# Empty = off. For local development Cloudflare's public test keys always pass:
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sign in with Google (Google Cloud console > APIs & Services > Credentials,
# an OAuth client of type "Web application"). Empty = no Google button.
# Authorised redirect URI: ${APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Address shown on the terms and privacy pages.
CONTACT_EMAIL=
